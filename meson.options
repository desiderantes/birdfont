option(
  'cli_tools',
  type: 'boolean',
  value: true,
  description: 'Build and install command-line tools (birdfont-autotrace, birdfont-export, birdfont-import)',
)

option(
  'tests',
  type: 'boolean',
  value: true,
  description: 'Build tests and benchmarks (birdfont-test)',
)

option(
  'fuzzing',
  type: 'boolean',
  value: false,
  description: 'Enable fuzzing targets (fuzz-bf, fuzz-svg)',
)

option(
  'experimental_non_null',
  type: 'boolean',
  value: false,
  description: 'Enable compile-time checks for null pointers',
)

option(
  'apport',
  type: 'boolean',
  value: false,
  description: 'Install Apport crash reporting hooks',
)
