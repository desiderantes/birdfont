libbirdfont_c = static_library(
    'birdfont-c',
    files(
        'overview_glyph.c',
        'Renderer/fontconfig.c',
    ),
    dependencies: [
        glib_dep,
        cairo_dep,
        fontconfig_dep,
        freetype_dep,
    ],
)

libbirdfont = shared_library(
    'libbirdfont',
    libbirdfont_sources,
    config_vala,
    loadfont_vapi,
    name_prefix: '',
    include_directories: include_directories(
        '.',
        'OpenFontFormat',
        'Renderer',
    ),
    link_whole: [libbirdfont_c],
    dependencies: [
        posix_dep,
        gee_dep,
        gio_dep,
        cairo_dep,
        cairo_gobject_dep,
        glib_dep,
        gobject_dep,
        gdk_pixbuf_dep,
        sqlite3_dep,
        xmlbird_dep,
        libbirdgems_dep,
        m_dep,
    ],
    vala_header: 'birdfont.h',
    vala_vapi: 'libbirdfont.vapi',
    version: libbirdfont_so_version,
    soversion: libbirdfont_so_version_major,
    install: true,
)

libbirdfont_dep = declare_dependency(
    link_with: [libbirdfont, libbirdgems],
    include_directories: include_directories(
        '.',
        'OpenFontFormat',
        'Renderer',
    ),
    dependencies: [
        gee_dep,
        gio_dep,
        cairo_dep,
        cairo_gobject_dep,
        glib_dep,
        gobject_dep,
        gdk_pixbuf_dep,
        sqlite3_dep,
        xmlbird_dep,
        m_dep,
    ],
)
